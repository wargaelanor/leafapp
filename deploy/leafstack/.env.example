# Скопируйте в .env и заполните. Секреты генерируются так:
#   Linux/macOS: openssl rand -hex 24
#   Windows:     PowerShell -c "-join ((48..57)+(97..122)|Get-Random -Count 32|%{[char]$_})"
#
# Без INFLUX_TOKEN / INFLUX_PASSWORD / GRAFANA_PASSWORD стек не запустится
# (compose намеренно падает, чтобы не поднять сервис с пустым паролем).

# --- InfluxDB ---
INFLUX_ADMIN_USER=leafadmin
INFLUX_PASSWORD=CHANGE_ME_STRONG
INFLUX_TOKEN=CHANGE_ME_HEX32_RANDOM
INFLUX_ORG=leaf
INFLUX_BUCKET=telemetry

# --- Grafana ---
GRAFANA_USER=leafview
GRAFANA_PASSWORD=CHANGE_ME_STRONG
# Публичный адрес Grafana (для корректных ссылок и redirect после логина):
#   локально  http://192.168.1.50:3000/
#   домен     https://grafana.example.com/
GRAFANA_ROOT_URL=http://localhost:3000/

# --- Порты на хосте (меняйте, если заняты) ---
TRACCAR_PORT=8925
GRAFANA_PORT=3000
INFLUX_PORT=8086
PORTAINER_PORT=9443

# --- Удалённый доступ (профиль remote) ---
# https://login.tailscale.com/admin/settings/keys  (Reusable, Ephemeral не нужен)
TS_AUTHKEY=
TS_HOSTNAME=leafstack
# true — если в системе нет /dev/net/tun (некоторые NAS); тогда сервисы
# публикуются через `tailscale serve`, см. README.
TS_USERSPACE=false
